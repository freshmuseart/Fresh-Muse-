# ─────────────────────────────────────────────────────────────────────────────
# Fresh Muse — social integration environment template
#
# COPY to `.env.local` (git-ignored) and fill in values locally.
# In production, set the SAME names in GitHub → Settings → Secrets and
# variables → Actions (never in this repository, never in frontend code).
#
# NO REAL VALUES belong in this file or in any committed file.
# `bun social/cli.ts connect <platform>` writes the token values into
# .env.local for you — you never have to paste them by hand.
# ─────────────────────────────────────────────────────────────────────────────

# ── Instagram (Meta) ─────────────────────────────────────────────────────────
# From Meta App Dashboard → Instagram → API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must EXACTLY match an OAuth redirect URI registered in the dashboard
# (Meta accepts localhost, e.g. http://localhost:8787/callback/instagram —
# exact match including any trailing slash).
INSTAGRAM_REDIRECT_URI=
# Optional — defaults to v25.0 if left empty.
INSTAGRAM_API_VERSION=

# Filled in by `bun social/cli.ts connect instagram` (do not hand-edit):
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN_OBTAINED_AT=
INSTAGRAM_TOKEN_EXPIRES_AT=

# ── TikTok ───────────────────────────────────────────────────────────────────
# From TikTok for Developers → your app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must EXACTLY match a redirect URL registered in the TikTok app console.
# NOTE: TikTok does NOT accept localhost — register an HTTPS URL, e.g. the
# deployed site URL: https://<OWNER>.github.io/<REPO>/
TIKTOK_REDIRECT_URI=
# Set to "true" ONLY after TikTok has actually granted video.publish
# (direct-post audit approved). Anything else keeps direct posts blocked.
TIKTOK_DIRECT_POST_APPROVED=

# Filled in by `bun social/cli.ts connect tiktok` (do not hand-edit):
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_TOKEN_OBTAINED_AT=
