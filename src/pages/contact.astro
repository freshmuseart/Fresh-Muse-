---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Fresh Muse — pitches, corrections, collaborations and quiet notes."
>
  <section class="section page-hero">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Contact</p>
      <h1>Send a note after hours.</h1>
      <p class="lede">
        Pitches, corrections, collaborations, gallery tips and quiet observations — all read by a
        person.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap contact-grid">
      <!--
        NON-PROGRAMMER NOTE: this form opens the visitor's own email client.
        To use a form service instead, replace `action` below with your
        provider's endpoint (e.g. Formspree, Buttondown).
      -->
      <form
        class="contact-form"
        method="post"
        action={`mailto:${site.contactEmail}`}
        enctype="text/plain"
      >
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <input id="subject" name="subject" type="text" />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="7" required></textarea>
        </div>
        <button class="btn btn--solid" type="submit">Compose message</button>
        <p class="contact-form__note">
          This opens your email app with the message ready to send — nothing is stored on this site.
        </p>
      </form>

      <aside class="contact-aside">
        <h2>Direct</h2>
        <p><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>

        <h2>Elsewhere</h2>
        <ul>
          {site.social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
            </li>
          ))}
        </ul>

        <blockquote>
          <p>“{site.philosophy}”</p>
        </blockquote>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    background:
      radial-gradient(60% 120% at 80% -20%, rgba(38, 46, 82, 0.55), transparent 70%);
    border-bottom: 1px solid var(--line);
  }

  .page-hero .wrap {
    display: grid;
    gap: 1.1rem;
  }

  .page-hero h1 {
    font-size: var(--step-4);
  }

  .section--tight {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contact-form {
    display: grid;
    gap: 1.4rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field label {
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .field input,
  .field textarea {
    padding: 0.9em 1.2em;
    background: rgba(4, 6, 13, 0.55);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--step-0);
    transition: border-color var(--speed) var(--ease);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--gold-dim);
  }

  .field textarea {
    resize: vertical;
  }

  .contact-form .btn {
    justify-self: start;
    cursor: pointer;
  }

  .contact-form__note {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .contact-aside {
    display: grid;
    gap: 1rem;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid var(--line);
    background: linear-gradient(160deg, rgba(20, 26, 48, 0.5), rgba(7, 10, 20, 0.85));
    border-radius: var(--radius);
  }

  .contact-aside h2 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 0.8rem;
  }

  .contact-aside h2:first-child {
    margin-top: 0;
  }

  .contact-aside ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .contact-aside a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .contact-aside a:hover {
    color: var(--gold);
  }

  .contact-aside blockquote p {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--gold);
    font-size: var(--step-1);
    margin-top: 1rem;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
