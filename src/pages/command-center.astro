---
/**
 * Fresh Muse — Command Center.
 *
 * A calm, editorial control panel: one text box, one button, a live preview,
 * and a record of what changed. All logic lives in `command-center/` — this
 * page is only its shell. In the published build it renders a quiet closed
 * notice; the live panel belongs to the studio environment.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const dev = import.meta.env.DEV;

const examples = [
  'Make the homepage title bigger.',
  'Change the newsletter button to black.',
  'Add TikTok to the social links.',
  'Make the mobile layout less crowded.',
];
---

<BaseLayout
  title="Command Center"
  description="Describe a change in plain English and watch the Fresh Muse site adapt."
>
  {
    dev ? (
      <section class="cc" data-live="true">
        <header class="cc-head">
          <p class="eyebrow">Fresh Muse — Studio</p>
          <h1>Command Center</h1>
          <p class="lede">
            Say what you would like changed, in your own words. The change is made,
            checked, and shown in the preview — nothing joins the site until you
            decide to keep it.
          </p>
        </header>

        <div class="cc-grid">
          <div class="cc-main">
            <form id="cc-form" class="composer">
              <textarea
                id="cc-input"
                rows="4"
                placeholder="Make the homepage feel more like an art magazine — keep the colours, but strengthen the typography…"
                aria-label="Describe the change you want"
              />
              <div class="composer-row">
                <button id="cc-apply" class="btn btn-primary" type="submit">
                  Apply change
                </button>
                <span class="hint">Plain English is enough.</span>
              </div>
            </form>

            <div class="chips" aria-label="Example instructions">
              {examples.map((text) => (
                <button class="chip" type="button" data-example={text}>
                  {text}
                </button>
              ))}
            </div>

            <div id="cc-ask" class="dialog" hidden>
              <p class="dialog-label">A question before I proceed</p>
              <p id="cc-ask-text" class="dialog-q" />
              <div class="dialog-row">
                <input id="cc-ask-input" type="text" placeholder="Your answer…" aria-label="Your answer" />
                <button id="cc-ask-send" class="btn btn-primary" type="button">
                  Send
                </button>
              </div>
            </div>

            <div id="cc-confirm" class="dialog confirm" hidden>
              <p class="dialog-label">Confirmation needed</p>
              <p id="cc-confirm-text" class="dialog-q" />
              <p id="cc-confirm-detail" class="dialog-detail" />
              <div class="dialog-row">
                <button id="cc-confirm-yes" class="btn btn-primary" type="button">
                  Yes, apply it
                </button>
                <button id="cc-confirm-no" class="btn btn-ghost" type="button">
                  No, cancel everything
                </button>
              </div>
            </div>

            <p id="cc-status" class="status" role="status" aria-live="polite" />

            <section class="block activity">
              <h2>Activity</h2>
              <ol id="cc-activity" />
            </section>

            <section class="block record">
              <div class="block-head">
                <h2>The record</h2>
                <button id="cc-undo" class="btn btn-ghost" type="button">
                  Undo last change
                </button>
              </div>
              <ol id="cc-history" />
              <p id="cc-empty" class="empty">
                Nothing yet — your first instruction will appear here.
              </p>
            </section>
          </div>

          <aside class="cc-side">
            <div class="preview-frame">
              <div class="preview-bar">
                <span class="preview-label">Live preview</span>
                <span class="preview-actions">
                  <button id="cc-refresh" class="linkish" type="button">
                    Refresh
                  </button>
                  <a href={import.meta.env.BASE_URL} target="_blank" rel="noopener">
                    Open ↗
                  </a>
                </span>
              </div>
              <iframe
                id="cc-preview"
                src={import.meta.env.BASE_URL}
                title="Fresh Muse live preview"
              />
            </div>
            <p class="side-note">
              Every change appears here at once, and stays <em>uncommitted</em> until you
              save it from Freebuff's Changes panel. Undo reverts the most recent change
              at any time.
            </p>
            <p id="cc-connections" class="side-note faint" />
          </aside>
        </div>
      </section>
    ) : (
      <section class="cc closed">
        <p class="eyebrow">Fresh Muse — Studio</p>
        <h1>Command Center</h1>
        <p class="lede">
          The Command Center lives alongside the site while it is being edited. The
          published site remains a quiet, static gallery — exactly as intended.
        </p>
        <a class="btn btn-primary" href={import.meta.env.BASE_URL}>
          Back to the site
        </a>
      </section>
    )
  }

  {dev && (
    <script>
      import { initPanel } from '../../command-center/ui/panel';
      initPanel();
    </script>
  )}

  <style>
    .cc {
      max-width: 1240px;
      margin: 0 auto;
      padding: clamp(2.5rem, 6vw, 5rem) var(--gutter) clamp(4rem, 8vw, 7rem);
    }

    .eyebrow {
      font-size: var(--step--1);
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1.1rem;
    }

    h1 {
      font-family: var(--font-display);
      font-weight: 340;
      font-size: var(--step-4);
      line-height: 1.04;
      color: var(--ink);
      letter-spacing: -0.01em;
    }

    .lede {
      margin-top: 1.1rem;
      max-width: 54ch;
      color: var(--ink-muted);
      font-size: var(--step-0);
    }

    .closed {
      min-height: 52vh;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
    }
    .closed .btn {
      margin-top: 2rem;
      text-decoration: none;
    }

    .cc-grid {
      margin-top: clamp(2.2rem, 5vw, 3.6rem);
      display: grid;
      gap: clamp(2rem, 4vw, 3.5rem);
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }

    @media (min-width: 980px) {
      .cc-grid {
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      }
      .cc-side {
        position: sticky;
        top: 2rem;
      }
    }

    /* --- composer ------------------------------------------------------- */

    .composer textarea {
      width: 100%;
      resize: vertical;
      min-height: 7.5rem;
      padding: 1.1rem 1.2rem;
      background: var(--night-900);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: var(--step-1);
      font-weight: 300;
      line-height: 1.6;
      transition: border-color 240ms var(--ease);
    }
    .composer textarea::placeholder {
      font-family: var(--font-display);
      font-style: italic;
      color: var(--ink-faint);
      font-weight: 300;
    }
    .composer textarea:focus {
      outline: none;
      border-color: var(--gold-dim);
    }

    .composer-row {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      margin-top: 0.9rem;
    }

    .hint {
      font-size: var(--step--1);
      color: var(--ink-faint);
      font-style: italic;
      font-family: var(--font-display);
    }

    .btn {
      appearance: none;
      cursor: pointer;
      font-family: var(--font-body);
      font-size: var(--step--1);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.85em 1.7em;
      border-radius: var(--radius);
      border: 1px solid transparent;
      background: transparent;
      transition:
        background 240ms var(--ease),
        color 240ms var(--ease),
        border-color 240ms var(--ease),
        opacity 240ms var(--ease);
    }
    .btn:disabled {
      opacity: 0.45;
      cursor: wait;
    }
    .btn-primary {
      border-color: var(--gold);
      color: var(--gold);
    }
    .btn-primary:hover:not(:disabled) {
      background: var(--gold);
      color: var(--night-950);
    }
    .btn-ghost {
      border-color: var(--line-strong);
      color: var(--ink-muted);
    }
    .btn-ghost:hover:not(:disabled) {
      border-color: var(--ink-muted);
      color: var(--ink);
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.1rem;
    }
    .chip {
      appearance: none;
      cursor: pointer;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--ink-muted);
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--step--1);
      padding: 0.45em 1.1em;
      transition:
        border-color 240ms var(--ease),
        color 240ms var(--ease);
    }
    .chip:hover {
      border-color: var(--gold-dim);
      color: var(--gold);
    }

    /* --- dialogs (ask / confirm) ---------------------------------------- */

    .dialog {
      margin-top: 1.4rem;
      padding: 1.2rem 1.3rem;
      background: var(--night-850);
      border: 1px solid var(--gold-dim);
      border-radius: var(--radius);
      animation: cc-rise 420ms var(--ease);
    }
    .dialog.confirm {
      border-color: rgba(217, 138, 120, 0.5);
    }
    .dialog-label {
      font-size: var(--step--1);
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.5rem;
    }
    .confirm .dialog-label {
      color: #d98a78;
    }
    .dialog-q {
      font-family: var(--font-display);
      font-size: var(--step-1);
      color: var(--ink);
      line-height: 1.45;
    }
    .dialog-detail {
      margin-top: 0.4rem;
      font-size: var(--step--1);
      color: var(--ink-faint);
      word-break: break-all;
    }
    .dialog-row {
      display: flex;
      gap: 0.8rem;
      margin-top: 1rem;
      flex-wrap: wrap;
    }
    .dialog-row input {
      flex: 1 1 16rem;
      padding: 0.7em 0.9em;
      background: var(--night-900);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: var(--step-0);
    }
    .dialog-row input:focus {
      outline: none;
      border-color: var(--gold-dim);
    }

    /* --- status ---------------------------------------------------------- */

    .status {
      margin-top: 1.6rem;
      min-height: 1.6rem;
      font-family: var(--font-display);
      font-size: var(--step-1);
      line-height: 1.5;
      color: var(--ink);
    }
    .status:empty {
      margin-top: 0.6rem;
      min-height: 0.4rem;
    }
    .status[data-kind='success'] {
      color: var(--gold);
    }
    .status[data-kind='error'] {
      color: #e0a091;
    }
    .status[data-kind='info'] {
      color: var(--ink-muted);
      font-size: var(--step-0);
      font-style: italic;
    }
    .status .hintline {
      display: block;
      font-family: var(--font-body);
      font-style: normal;
      font-size: var(--step--1);
      color: var(--ink-muted);
      margin-top: 0.35rem;
      white-space: pre-wrap;
      max-height: 14rem;
      overflow-y: auto;
    }

    /* --- blocks: activity + record --------------------------------------- */

    .block {
      margin-top: clamp(2rem, 4vw, 3rem);
    }
    .block h2 {
      font-family: var(--font-display);
      font-weight: 340;
      font-size: var(--step-1);
      color: var(--ink);
      letter-spacing: 0.02em;
    }
    .block-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.7rem;
    }

    #cc-activity {
      list-style: none;
      margin-top: 0.9rem;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      max-height: 16rem;
      overflow-y: auto;
    }
    #cc-activity li {
      font-size: var(--step--1);
      color: var(--ink-muted);
      display: flex;
      gap: 0.6rem;
      align-items: baseline;
      animation: cc-rise 320ms var(--ease);
    }
    #cc-activity li::before {
      content: '';
      width: 5px;
      height: 5px;
      flex: none;
      border-radius: 50%;
      background: var(--gold-dim);
      transform: translateY(-1px);
    }
    #cc-activity li.is-stage {
      font-family: var(--font-display);
      font-style: italic;
      color: var(--ink-soft);
      font-size: var(--step-0);
    }
    #cc-activity li.is-fail::before {
      background: #d98a78;
    }
    #cc-activity li.is-ok::before {
      background: var(--gold);
    }
    #cc-activity li .path {
      color: var(--ink-faint);
      word-break: break-all;
    }

    #cc-history {
      list-style: none;
      margin-top: 0.3rem;
    }
    #cc-history li {
      padding: 1rem 0;
      border-bottom: 1px solid var(--line);
      animation: cc-rise 320ms var(--ease);
    }
    .rec-instr {
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--step-0);
      color: var(--ink);
      line-height: 1.5;
    }
    .rec-summary {
      margin-top: 0.3rem;
      font-size: var(--step--1);
      color: var(--ink-muted);
      line-height: 1.6;
    }
    .rec-meta {
      margin-top: 0.45rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      align-items: center;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .rec-status {
      padding: 0.15em 0.7em;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
    }
    .rec-status.applied {
      color: var(--gold);
      border-color: var(--gold-dim);
    }
    .rec-status.failed {
      color: #e0a091;
      border-color: rgba(217, 138, 120, 0.45);
    }
    .rec-status.undone {
      color: var(--ink-faint);
    }
    .rec-files {
      margin-top: 0.4rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .rec-files span {
      font-size: 0.72rem;
      color: var(--ink-faint);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 0.1em 0.6em;
      word-break: break-all;
    }

    .empty {
      margin-top: 1rem;
      font-family: var(--font-display);
      font-style: italic;
      color: var(--ink-faint);
      font-size: var(--step-0);
    }

    /* --- preview --------------------------------------------------------- */

    .preview-frame {
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      overflow: hidden;
      background: var(--night-900);
    }
    .preview-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.55rem 0.9rem;
      border-bottom: 1px solid var(--line);
      background: var(--night-850);
    }
    .preview-label {
      font-size: 0.7rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--gold);
    }
    .preview-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
      font-size: var(--step--1);
    }
    .preview-actions a,
    .linkish {
      color: var(--ink-muted);
      text-decoration: none;
      background: none;
      border: none;
      cursor: pointer;
      font-family: var(--font-body);
      font-size: var(--step--1);
      padding: 0;
      transition: color 240ms var(--ease);
    }
    .preview-actions a:hover,
    .linkish:hover {
      color: var(--gold);
    }
    #cc-preview {
      display: block;
      width: 100%;
      height: clamp(26rem, 60vh, 44rem);
      border: none;
      background: var(--night-950);
    }

    .side-note {
      margin-top: 0.9rem;
      font-size: var(--step--1);
      color: var(--ink-muted);
      line-height: 1.7;
    }
    .side-note em {
      font-family: var(--font-display);
      color: var(--ink-soft);
    }
    .side-note.faint {
      color: var(--ink-faint);
    }

    @keyframes cc-rise {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .dialog,
      #cc-activity li,
      #cc-history li {
        animation: none;
      }
    }
  </style>
</BaseLayout>
