---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/url';

const groups = [
  {
    title: 'For artists & makers',
    items: [
      {
        name: 'Portfolio basics',
        note: 'How to sequence work so it reads as a practice, not a pile.',
        href: '/artists',
      },
      {
        name: 'Pricing without apology',
        note: 'A working framework for editions, commissions and one-offs.',
        href: '/collectible-objects',
      },
      {
        name: 'Studio rituals',
        note: 'Small systems that keep the work moving on low-energy days.',
        href: '/articles/the-last-letterpress-studio-above-a-bakery',
      },
    ],
  },
  {
    title: 'For collectors & readers',
    items: [
      {
        name: 'Starting a collection',
        note: 'What to buy first when the budget is honest and small.',
        href: '/articles/art-the-size-of-a-matchbox',
      },
      {
        name: 'Living with art',
        note: 'Placement, light, rotation — rooms that keep breathing.',
        href: '/art-interior',
      },
      {
        name: 'Editions explained',
        note: 'Numbers, proofs, signatures: what the little fraction means.',
        href: '/articles/twelve-of-twelve-why-the-last-edition-sells-first',
      },
    ],
  },
  {
    title: 'For the curious',
    items: [
      {
        name: 'Reading a painting',
        note: 'A short primer on looking slowly, without needing a degree.',
        href: '/articles/who-decided-the-sky-was-blue',
      },
      {
        name: 'Glossary of movements',
        note: 'From Baroque to relational aesthetics, briefly.',
        href: '/art-history',
      },
      {
        name: 'Museums after hours',
        note: 'How to visit like an editor rather than a tourist.',
        href: '/art-you-almost-missed',
      },
    ],
  },
];
---

<BaseLayout
  title="Resources"
  description="Tools, references and practical guidance for artists, collectors and curious readers — curated by Fresh Muse."
>
  <section class="section page-hero">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Resources</p>
      <h1>Tools for living with art.</h1>
      <p class="lede">
        Practical guidance, gathered slowly. Every entry is written or curated by Fresh Muse —
        no affiliate clutter, no filler.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      {
        groups.map((group) => (
          <div class="res-group">
            <h2>{group.title}</h2>
            <div class="res-grid">
              {group.items.map((item) => (
                <a class="res-card" href={url(item.href)}>
                  <h3>{item.name}</h3>
                  <p>{item.note}</p>
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    background:
      radial-gradient(60% 120% at 85% -25%, rgba(38, 46, 82, 0.55), transparent 70%),
      radial-gradient(30% 60% at 5% 30%, rgba(200, 168, 106, 0.06), transparent 70%);
    border-bottom: 1px solid var(--line);
  }

  .page-hero .wrap {
    display: grid;
    gap: 1.1rem;
  }

  .page-hero h1 {
    font-size: var(--step-4);
  }

  .section--tight {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .res-group h2 {
    font-size: var(--step-2);
    margin-bottom: 1.4rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .res-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .res-card {
    position: relative;
    display: grid;
    gap: 0.7rem;
    align-content: start;
    padding: clamp(1.4rem, 2.5vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(165deg, rgba(20, 26, 48, 0.5), rgba(7, 10, 20, 0.9));
    text-decoration: none;
    transition: border-color var(--speed) var(--ease), transform var(--speed) var(--ease);
  }

  .res-card:hover {
    border-color: var(--gold-dim);
    transform: translateY(-4px);
    color: inherit;
  }

  .res-card h3 {
    font-size: var(--step-1);
  }

  .res-card p {
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .res-card span {
    color: var(--gold);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--speed) var(--ease), transform var(--speed) var(--ease);
  }

  .res-card:hover span {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 900px) {
    .res-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .res-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
