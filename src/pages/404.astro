---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/url';
---

<BaseLayout title="Not Found" description="This room of the gallery is empty.">
  <section class="section lost">
    <div class="wrap wrap--narrow lost__inner">
      <p class="lost__mark" aria-hidden="true">✳</p>
      <p class="eyebrow">Error 404</p>
      <h1>This room of the gallery is empty.</h1>
      <p class="lede">
        The page you were looking for has been moved, renamed, or never hung on this wall.
      </p>
      <div class="lost__actions">
        <a class="btn btn--solid" href={url('/')}>Return to the front page</a>
        <a class="btn" href={url('/articles')}>Browse all writing</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    min-height: 62vh;
    display: grid;
    align-items: center;
    background:
      radial-gradient(50% 70% at 50% 30%, rgba(38, 46, 82, 0.55), transparent 75%);
  }

  .lost__inner {
    display: grid;
    gap: 1.2rem;
    justify-items: center;
    text-align: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .lost__mark {
    font-size: var(--step-4);
    color: var(--gold);
    animation: slow-spin 18s linear infinite;
  }

  .lost h1 {
    font-size: var(--step-3);
    max-width: 18ch;
  }

  .lost .lede {
    max-width: 46ch;
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.8rem;
  }

  @keyframes slow-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
