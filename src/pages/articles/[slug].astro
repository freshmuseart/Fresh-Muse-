---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArtPlate from '../../components/ArtPlate.astro';
import { getCategory, categories } from '../../data/categories';
import { url } from '../../utils/url';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const cat = getCategory(entry.data.category);

/** Reading time estimated from the raw markdown body (when available). */
const words = entry.body ? entry.body.split(/\s+/).length : 0;
const readingMinutes = words > 0 ? Math.max(1, Math.round(words / 220)) : null;

/** Previous / next article in chronological order (newest first). */
const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const idx = all.findIndex((a) => a.id === entry.id);
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;

const others = (
  await getCollection('articles', ({ data }) => !data.draft && data.category === entry.data.category)
)
  .filter((a) => a.id !== entry.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const siblings = categories.filter((c) => c.slug !== entry.data.category).slice(0, 4);

const formatted = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(entry.data.date);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="article">
    <!-- ======================= HEADER ======================= -->
    <header class="article__head">
      <div class="wrap wrap--narrow">
        <p class="eyebrow">
          {cat ? <a href={url(`/${cat.slug}`)}>{cat.title}</a> : 'Journal'}
        </p>
        <h1>{entry.data.title}</h1>
        <p class="article__dek">{entry.data.description}</p>
        <p class="article__byline">
          <span>{entry.data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={entry.data.date.toISOString()}>{formatted}</time>
          {readingMinutes && (
            <>
              <span aria-hidden="true">·</span>
              <span>{readingMinutes} min read</span>
            </>
          )}
        </p>
      </div>
    </header>

    <!-- ======================== PLATE ======================== -->
    <div class="wrap article__plate">
      <ArtPlate seed={entry.id} />
    </div>

    <!-- ======================== BODY ========================= -->
    <div class="wrap wrap--narrow article__body prose">
      <Content />
    </div>

    {(newer || older) && (
      <nav class="wrap wrap--narrow article__pager" aria-label="Previous and next article">
        {older ? (
          <a class="article__pager-link" href={url(`/articles/${older.id}`)} rel="prev">
            <span class="article__pager-label">← Previous</span>
            <span class="article__pager-title">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer ? (
          <a class="article__pager-link article__pager-link--next" href={url(`/articles/${newer.id}`)} rel="next">
            <span class="article__pager-label">Next →</span>
            <span class="article__pager-title">{newer.data.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}

    <nav class="wrap wrap--narrow article__foot" aria-label="Article navigation">
      <a class="btn" href={url('/articles')}>← All writing</a>
      {cat && <a class="btn" href={url(`/${cat.slug}`)}>More in {cat.title}</a>}
    </nav>
  </article>

  {
    others.length > 0 && (
      <section class="section section--tinted">
        <div class="wrap">
          <p class="eyebrow">Keep reading</p>
          <div class="more-grid">
            {others.map((o) => (
              <ArticleCard
                title={o.data.title}
                description={o.data.description}
                category={o.data.category}
                date={o.data.date}
                slug={o.id}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Other sections</p>
      <div class="siblings">
        {
          siblings.map((c) => (
            <a href={url(`/${c.slug}`)}>
              <span>{c.index}</span> {c.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article__head {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2rem, 4vw, 3rem);
    text-align: center;
    background:
      radial-gradient(60% 100% at 50% 0%, rgba(38, 46, 82, 0.5), transparent 75%);
    border-bottom: 1px solid var(--line);
  }

  .article__head .wrap {
    display: grid;
    gap: 1.2rem;
    justify-items: center;
  }

  .article__head h1 {
    font-size: var(--step-4);
    max-width: 20ch;
  }

  .article__dek {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink-muted);
    max-width: 52ch;
    line-height: 1.5;
  }

  .article__byline {
    display: flex;
    gap: 0.8em;
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .article__byline span:first-child {
    color: var(--ink-muted);
  }

  .article__plate {
    margin-top: clamp(2rem, 4vw, 3rem);
    aspect-ratio: 21 / 9;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-deep);
  }

  .article__body {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    margin-inline: auto;
    font-size: var(--step-1);
    line-height: 1.8;
  }

  /* first paragraph drop-styling */
  .article__body :global(p:first-of-type::first-letter) {
    font-family: var(--font-display);
    font-size: 3.4em;
    line-height: 0.8;
    float: left;
    padding-right: 0.12em;
    padding-top: 0.06em;
    color: var(--gold);
  }

  .article__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2vw, 1.6rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .article__pager-link {
    display: grid;
    gap: 0.5rem;
    padding: 1.3rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--speed) var(--ease), transform var(--speed) var(--ease);
  }

  .article__pager-link--next {
    text-align: right;
  }

  .article__pager-link:hover {
    border-color: var(--gold-dim);
    transform: translateY(-3px);
  }

  .article__pager-label {
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .article__pager-title {
    font-family: var(--font-display);
    font-size: var(--step-0);
    color: var(--ink);
    line-height: 1.3;
  }

  @media (max-width: 620px) {
    .article__pager {
      grid-template-columns: 1fr;
    }
  }

  .article__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--line);
  }

  .section--tinted {
    background: var(--night-900);
    border-bottom: 1px solid var(--line);
  }

  .more-grid,
  .siblings {
    display: grid;
    gap: clamp(1rem, 2vw, 1.6rem);
    margin-top: 1.6rem;
  }

  .more-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .siblings {
    grid-template-columns: repeat(4, 1fr);
  }

  .siblings a {
    display: grid;
    gap: 0.5rem;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: var(--step-0);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--speed) var(--ease), transform var(--speed) var(--ease);
  }

  .siblings a span {
    font-size: var(--step--1);
    letter-spacing: 0.3em;
    color: var(--gold);
  }

  .siblings a:hover {
    border-color: var(--gold-dim);
    transform: translateY(-3px);
  }

  @media (max-width: 900px) {
    .more-grid {
      grid-template-columns: 1fr 1fr;
    }
    .siblings {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .more-grid {
      grid-template-columns: 1fr;
    }
    .article__plate {
      aspect-ratio: 16 / 10;
    }
  }
</style>
