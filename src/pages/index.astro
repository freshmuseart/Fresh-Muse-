---
import BaseLayout from '../layouts/BaseLayout.astro';
import NightSky from '../components/NightSky.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { categories } from '../data/categories';
import { site } from '../data/site';
import { url } from '../utils/url';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = articles.filter((a) => a.data.featured).slice(0, 3);
const latest = (featured.length ? articles.filter((a) => !featured.includes(a)) : articles).slice(0, 3);
---

<BaseLayout>
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <NightSky class="hero__sky" />
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="wrap hero__inner">
      <p class="eyebrow hero__eyebrow">An independent art publication</p>
      <h1 class="hero__title">
        Fresh <em>Muse</em>
      </h1>
      <p class="hero__statement">{site.tagline}</p>

      <div class="hero__actions">
        <a class="btn btn--solid" href="#discover">Enter the journal</a>
        <a class="btn" href={url('/about')}>About Fresh Muse</a>
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true">
      <span>Scroll</span>
      <span class="hero__scroll-line"></span>
    </div>
  </section>

  <!-- ========================= DISCOVERY ========================== -->
  <section class="section" id="discover">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">Editorial discovery</p>
        <h2 class="section-head__title">Five ways into the work.</h2>
        <p class="lede">
          Fresh Muse moves between the overlooked, the atmospheric and the historical — art read
          as a way of living rather than a category of goods.
        </p>
      </header>

      <div class="discover-grid">
        {
          categories.map((cat, i) => (
            <a
              href={url(`/${cat.slug}`)}
              class:list={['discover-card', { 'discover-card--wide': i < 2 }]}
            >
              <span class="discover-card__index">{cat.index}</span>
              <h3 class="discover-card__title">{cat.title}</h3>
              <p class="discover-card__tagline">{cat.tagline}</p>
              <span class="discover-card__arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= FEATURED EDITORIAL ==================== -->
  <section class="section section--tinted">
    <div class="wrap">
      <header class="section-head section-head--row">
        <div>
          <p class="eyebrow">Featured editorial</p>
          <h2 class="section-head__title">Recently in the journal.</h2>
        </div>
        <a class="btn" href={url('/articles')}>All writing</a>
      </header>

      {
        featured.length > 0 ? (
          <div class="card-grid card-grid--featured">
            {featured.map((entry) => (
              <ArticleCard
                title={entry.data.title}
                description={entry.data.description}
                category={entry.data.category}
                date={entry.data.date}
                slug={entry.id}
                featured
              />
            ))}
          </div>
        ) : (
          <p class="empty-note">New writing is being set. First pieces arrive shortly.</p>
        )
      }

      {
        latest.length > 0 && (
          <div class="card-grid card-grid--three">
            {latest.map((entry) => (
              <ArticleCard
                title={entry.data.title}
                description={entry.data.description}
                category={entry.data.category}
                date={entry.data.date}
                slug={entry.id}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- ========================= ABOUT INTRO ========================= -->
  <section class="section about-intro">
    <div class="wrap about-intro__grid">
      <div class="about-intro__copy">
        <p class="eyebrow">About Fresh Muse</p>
        <h2>
          Art does not have to belong only in museums or to wealthy collectors.
        </h2>
        <p class="lede">
          Fresh Muse explores how art, objects, artists, materials and creative ideas can become
          part of everyday life — an intersection of independent publication, contemporary gallery
          and quiet cultural field guide.
        </p>
        <a class="btn" href={url('/about')}>Read our story</a>
      </div>

      <aside class="about-intro__aside" aria-label="Fresh Muse principles">
        <blockquote>
          <p>“{site.philosophy}”</p>
          <footer>— the Fresh Muse editorial position</footer>
        </blockquote>
        <ul>
          <li><span>01</span> Curiosity over trend</li>
          <li><span>02</span> Attention over acquisition</li>
          <li><span>03</span> Atmosphere over noise</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- ========================= NEWSLETTER ========================== -->
  <Newsletter />
</BaseLayout>

<style>
  /* --- hero --------------------------------------------------------------- */
  .hero {
    position: relative;
    min-height: clamp(560px, 92svh, 940px);
    display: grid;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 50% 46%, transparent, rgba(4, 6, 13, 0.72) 100%),
      linear-gradient(180deg, rgba(4, 6, 13, 0.55), transparent 30%, rgba(4, 6, 13, 0.85));
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: clamp(1.2rem, 2.5vw, 2rem);
    padding-block: clamp(5rem, 12vh, 8rem);
  }

  .hero__eyebrow {
    animation: rise 900ms var(--ease) both;
  }

  .hero__title {
    font-size: var(--step-5);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 0.98;
    text-transform: none;
    animation: rise 900ms 120ms var(--ease) both;
  }

  .hero__title em {
    font-style: italic;
    font-weight: 350;
    color: var(--gold);
  }

  .hero__statement {
    max-width: 34ch;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 300;
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.4;
    animation: rise 900ms 240ms var(--ease) both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: clamp(0.5rem, 2vh, 1.5rem);
    animation: rise 900ms 360ms var(--ease) both;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    transform: translateX(-50%);
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    font-size: var(--step--1);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .hero__scroll-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(var(--gold), transparent);
    animation: drip 2.4s var(--ease) infinite;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes drip {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  /* --- section heads ------------------------------------------------------ */
  .section-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    max-width: 720px;
  }

  .section-head--row {
    max-width: none;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
  }

  .section-head__title {
    font-size: var(--step-3);
  }

  @media (max-width: 720px) {
    .section-head--row {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  /* --- tinted band --------------------------------------------------------- */
  .section--tinted {
    background:
      radial-gradient(80% 60% at 15% 0%, rgba(38, 46, 82, 0.35), transparent 70%),
      var(--night-900);
    border-block: 1px solid var(--line);
  }

  /* --- discovery grid ------------------------------------------------------- */
  .discover-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(0.9rem, 1.6vw, 1.4rem);
  }

  .discover-card {
    position: relative;
    grid-column: span 2;
    display: grid;
    align-content: start;
    gap: 0.8rem;
    min-height: 240px;
    padding: clamp(1.5rem, 2.6vw, 2.3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(165deg, rgba(20, 26, 48, 0.55), rgba(7, 10, 20, 0.9));
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color var(--speed) var(--ease),
      transform var(--speed) var(--ease),
      background-color var(--speed) var(--ease);
  }

  .discover-card--wide {
    grid-column: span 3;
  }

  .discover-card:hover {
    border-color: var(--gold-dim);
    transform: translateY(-5px);
    color: inherit;
  }

  /* drifting curve motif on hover */
  .discover-card::before {
    content: '';
    position: absolute;
    right: -30%;
    bottom: -55%;
    width: 90%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(200, 168, 106, 0.12), transparent);
    opacity: 0;
    transition: opacity var(--speed) var(--ease);
    pointer-events: none;
  }

  .discover-card:hover::before {
    opacity: 1;
  }

  .discover-card__index {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.3em;
    color: var(--gold);
  }

  .discover-card__title {
    font-size: var(--step-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.15;
  }

  .discover-card__tagline {
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.6;
    max-width: 42ch;
  }

  .discover-card__arrow {
    margin-top: auto;
    justify-self: start;
    color: var(--gold);
    transform: translateX(-8px);
    opacity: 0;
    transition: transform var(--speed) var(--ease), opacity var(--speed) var(--ease);
  }

  .discover-card:hover .discover-card__arrow {
    transform: translateX(0);
    opacity: 1;
  }

  @media (max-width: 900px) {
    .discover-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .discover-card,
    .discover-card--wide {
      grid-column: span 1;
    }
  }

  @media (max-width: 560px) {
    .discover-grid {
      grid-template-columns: 1fr;
    }
  }

  /* --- article grids ---------------------------------------------------------- */
  .card-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.6rem);
  }

  .card-grid--featured {
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: clamp(1rem, 2vw, 1.6rem);
  }

  .card-grid--three {
    grid-template-columns: repeat(3, 1fr);
  }

  .empty-note {
    color: var(--ink-muted);
    font-style: italic;
    font-family: var(--font-display);
  }

  @media (max-width: 900px) {
    .card-grid--featured,
    .card-grid--three {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .card-grid--featured,
    .card-grid--three {
      grid-template-columns: 1fr;
    }
  }

  /* --- about intro ------------------------------------------------------------- */
  .about-intro__grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .about-intro__copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .about-intro__copy h2 {
    font-size: var(--step-3);
    max-width: 22ch;
  }

  .about-intro__aside {
    display: grid;
    gap: 2rem;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid var(--line);
    background: linear-gradient(160deg, rgba(20, 26, 48, 0.5), rgba(7, 10, 20, 0.85));
    border-radius: var(--radius);
  }

  .about-intro__aside blockquote p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--gold);
    line-height: 1.35;
  }

  .about-intro__aside blockquote footer {
    margin-top: 0.8rem;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .about-intro__aside ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    border-top: 1px solid var(--line);
    padding-top: 1.6rem;
  }

  .about-intro__aside li {
    display: flex;
    gap: 1em;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .about-intro__aside li span {
    color: var(--gold);
    font-family: var(--font-display);
  }

  @media (max-width: 860px) {
    .about-intro__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
