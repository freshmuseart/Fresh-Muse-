---
import { site, footerNav } from '../data/site';
import { url } from '../utils/url';

const year = new Date().getFullYear();
const socials = site.social;
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <a class="footer__wordmark" href={url('/')}>{site.name}</a>
      <p class="footer__tagline">{site.tagline}</p>
      <p class="footer__philosophy">{site.philosophy}</p>
    </div>

    {
      footerNav.map((group) => (
        <nav class="footer__col" aria-label={group.heading}>
          <h3>{group.heading}</h3>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={url(link.href)}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="footer__col">
      <h3>Follow</h3>
      <ul>
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="noopener noreferrer" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap footer__base">
    <p>© {year} {site.name}. All rights reserved.</p>
    <p>
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-y);
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(14, 19, 36, 0.6));
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .footer__tagline {
    margin-top: 0.8rem;
    color: var(--ink-muted);
    max-width: 30ch;
    font-size: var(--step--1);
  }

  .footer__philosophy {
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--gold);
    font-size: var(--step-0);
  }

  .footer__col h3 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 1.1rem;
  }

  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .footer__col a {
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
  }

  .footer__col a:hover {
    color: var(--gold);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .footer__base a {
    color: var(--ink-faint);
    text-decoration: none;
  }

  .footer__base a:hover {
    color: var(--gold);
  }

  @media (max-width: 860px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
