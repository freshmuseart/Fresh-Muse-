---
import { site, primaryNav } from '../data/site';
import { url } from '../utils/url';

const pathname = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => pathname === href.replace(/\/$/, '');
---

<header class="masthead">
  <div class="wrap masthead__inner">
    <a class="wordmark" href={url('/')} aria-label={`${site.name} — home`}>
      <span class="wordmark__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20">
          <path
            d="M12 2c1.8 4.6 4.4 7.2 9 9-4.6 1.8-7.2 4.4-9 9-1.8-4.6-4.4-7.2-9-9 4.6-1.8 7.2-4.4 9-9z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="wordmark__text">Fresh Muse</span>
    </a>

    <nav class="masthead__nav" aria-label="Primary">
      <ul>
        {
          primaryNav.map((item) => (
            <li>
              <a href={url(item.href)} class:list={[{ active: isActive(item.href) }]}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <ul>
        {
          primaryNav.map((item) => (
            <li>
              <a href={url(item.href)}>{item.label}</a>
            </li>
          ))
        }
        <li><a href={url('/resources')}>Resources</a></li>
        <li><a href={url('/contact')}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });

  // close menu when a link is chosen
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      if (menu) menu.hidden = true;
      document.body.style.overflow = '';
    });
  });
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--night-950) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 68px;
    padding-block: 0.6rem;
  }

  /* --- wordmark ------------------------------------------------------------ */
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    color: var(--ink);
  }

  .wordmark__mark {
    color: var(--gold);
    display: inline-flex;
    transition: transform 600ms var(--ease);
  }

  .wordmark:hover .wordmark__mark {
    transform: rotate(90deg);
  }

  .wordmark__text {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  /* --- desktop nav ---------------------------------------------------------- */
  .masthead__nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 1.9rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .masthead__nav a {
    position: relative;
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-muted);
    padding-block: 0.4em;
    transition: color var(--speed) var(--ease);
  }

  .masthead__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--speed) var(--ease);
  }

  .masthead__nav a:hover,
  .masthead__nav a.active {
    color: var(--ink);
  }

  .masthead__nav a:hover::after,
  .masthead__nav a.active::after {
    transform: scaleX(1);
  }

  /* --- mobile toggle ---------------------------------------------------------- */
  .menu-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: border-color var(--speed) var(--ease);
  }

  .menu-toggle:hover {
    border-color: var(--gold-dim);
  }

  .menu-toggle__bars,
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    transform: translate(-50%, -50%);
    transition: transform 300ms var(--ease), opacity 300ms var(--ease);
  }

  .menu-toggle__bars::before {
    transform: translate(-50%, calc(-50% - 6px));
  }

  .menu-toggle__bars::after {
    transform: translate(-50%, calc(-50% + 6px));
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
    background: transparent;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* --- mobile menu ------------------------------------------------------------ */
  .mobile-menu {
    position: fixed;
    inset: 68px 0 0 0;
    z-index: 49;
    background: color-mix(in srgb, var(--night-950) 96%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: var(--gutter);
    overflow-y: auto;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }

  .mobile-menu a {
    display: block;
    padding: 0.9em 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu a:hover {
    color: var(--gold);
  }

  @media (max-width: 900px) {
    .masthead__nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }
  }
</style>
